{
  "name": "tropical-island-survival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "types": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vite build && playwright test",
    "pictures": "playwright test tests/pictures.spec.ts",
    "check": "npm run types && npm run lint && npm run test",
    "check:quick": "npm run types && npm run lint && vite build && playwright test --grep @quick",
    "site": "node tools/assemble-site.ts"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.128.0",
    "eslint": "^10.14.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-glsl": "^1.6.2",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "three": "0.128.0"
  }
}
